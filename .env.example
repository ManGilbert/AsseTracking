# Device Management System - Environment Configuration
# Copy this file to .env and update with your values

# Django Settings
SECRET_KEY=django-insecure-kzisvminvk=a9=@0d+^n+my_cjzc89yqhv1fzx-&28s12fp%6j
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database Configuration
# For Development (SQLite)
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# For Production (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=dms_database
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME=3600
JWT_REFRESH_TOKEN_LIFETIME=86400

# Email Configuration (for notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# API Configuration
API_PAGINATION_PAGE_SIZE=20
API_RATE_LIMIT_ENABLED=True
API_RATE_LIMIT_PER_HOUR=1000

# Security Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/dms.log

# Redis Configuration (optional, for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# AWS Configuration (optional, for file storage)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1

# Celery Configuration (optional, for async tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Application Name & Version
APP_NAME=Device Management System
APP_VERSION=1.0.0
APP_ENV=production

# Time Zone
TIME_ZONE=UTC

# Language
LANGUAGE_CODE=en-us
